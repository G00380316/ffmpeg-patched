+/* Moves one representation for a seek. It is no longer at its end. One the
+ * caller no longer wants is closed first, as recheck_discard_flags() would on
+ * the next read, so that the seek does not reopen it. A closed one keeps its
+ * place by segment number, or, if it is one whole file with no initialization
+ * apart, by the position the dry seek remembers, which
+ * recheck_discard_flags() applies when it reopens it. */
+static int seek_representation(AVFormatContext *s, struct representation *pls,
+                               int64_t seek_pos_msec, int flags)
+{
+    pls->ended = 0;
+    if (pls->ctx && !representation_needed(pls)) {
+        close_demux_for_component(pls);
+        ff_format_io_close(pls->parent, &pls->input);
+    }
+    /* Seek a closed one with dry_run=1 to avoid reopening it */
+    return dash_seek(s, pls, seek_pos_msec, flags, !pls->ctx);
+}

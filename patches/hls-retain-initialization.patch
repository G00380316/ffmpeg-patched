+/* Keep the effective map identity stable across live playlist reloads. The
+ * input retains the current initialization bytes, so a fresh allocation for
+ * an unchanged MAP would unnecessarily fetch and inject them again. */
+static struct segment *retain_init_section(struct playlist *pls,
+                                          struct segment *sec)
+{
+    int i;
+    for (i = 0; i < pls->n_init_sections; i++) {
+        struct segment *existing = pls->init_sections[i];
+        if (existing->size != sec->size || existing->url_offset != sec->url_offset ||
+            existing->key_type != sec->key_type || strcmp(existing->url, sec->url))
+            continue;
+        if (sec->key_type != KEY_NONE &&
+            (strcmp(existing->key, sec->key) || memcmp(existing->iv, sec->iv, sizeof(sec->iv))))
+            continue;
+        av_freep(&sec->key);
+        av_freep(&sec->url);
+        av_free(sec);
+        return existing;
+    }
+    dynarray_add(&pls->init_sections, &pls->n_init_sections, sec);
     return sec;
 }
 
+/* Retain only the current reader's map and maps still referenced by the live
+ * window. Rotating map URIs must not grow this list for the entire session. */
+static void prune_init_sections(struct playlist *pls)
+{
+    int i, j, kept = 0;
+    for (i = 0; i < pls->n_init_sections; i++) {
+        struct segment *sec = pls->init_sections[i];
+        int referenced = sec == pls->cur_init_section;
+        for (j = 0; !referenced && j < pls->n_segments; j++)
+            referenced = pls->segments[j]->init_section == sec;
+        if (referenced) {
+            pls->init_sections[kept++] = sec;
+        } else {
+            av_freep(&sec->key);
+            av_freep(&sec->url);
+            av_free(sec);
+        }
+    }
+    pls->n_init_sections = kept;
+}

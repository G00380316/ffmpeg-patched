+
+/* The attribute the jar tags a cookie with: the origin of the response that
+ * set it, which is the only origin it goes back to. */
+#define COOKIE_ORIGIN "x-jar-origin"
+/* The attribute marking a cookie set on a response to a request that went
+ * without the credentials: such a cookie carries none of them, and goes back
+ * to its origin on a request that returns there from another, where the rest
+ * of its origin's cookies do not. */
+#define COOKIE_WITHHELD "x-jar-withheld"
+
+/* Whether an attribute or cookie name is one of the jar's own, which no
+ * server may set. */
+static int http_is_jar_attribute(const char *name, size_t length)
+{
+    return (length == strlen(COOKIE_ORIGIN) &&
+            !av_strncasecmp(name, COOKIE_ORIGIN, length)) ||
+           (length == strlen(COOKIE_WITHHELD) &&
+            !av_strncasecmp(name, COOKIE_WITHHELD, length));
+}
+
+/* The origin of an http(s) URL -- its scheme and host, lowercased, and its
+ * port, the scheme's default filled in -- as scheme://host:port. */
+static int http_url_origin(const char *url, char *origin, int origin_size)
+{
+    char proto[16], hostname[1024];
+    int port, i;
+
+    av_url_split(proto, sizeof(proto), NULL, 0, hostname, sizeof(hostname),
+                 &port, NULL, 0, url);
+    for (i = 0; proto[i]; i++)
+        proto[i] = av_tolower(proto[i]);
+    for (i = 0; hostname[i]; i++)
+        hostname[i] = av_tolower(hostname[i]);
+    if (!strcmp(proto, "http"))
+        port = port < 0 ? 80 : port;
+    else if (!strcmp(proto, "https"))
+        port = port < 0 ? 443 : port;
+    else
+        return AVERROR(EINVAL);
+    if (!hostname[0])
+        return AVERROR(EINVAL);
+    snprintf(origin, origin_size,
+             strchr(hostname, ':') ? "%s://[%s]:%d" : "%s://%s:%d",
+             proto, hostname, port);
+    return 0;
+}
+
+/* Whether `url` is on another origin than the one the context's headers,
+ * referer and cookies were given for. `origin` gets the URL's. */
+static int http_is_other_origin(HTTPContext *s, const char *url,
+                                char *origin, int origin_size)
+{
+    char given[1024];
+
+    if (http_url_origin(url, origin, origin_size) < 0)
+        origin[0] = '\0';
+    if (!s->credentials_origin || !s->credentials_origin[0])
+        return 0;
+    return !origin[0] ||
+           http_url_origin(s->credentials_origin, given, sizeof(given)) < 0 ||
+           strcmp(origin, given);
+}
+
+/* The lines of a header block that go to another origin: those naming what
+ * the client accepts, and its agent. A line ends at a CR, an LF or both, so
+ * that no line is carried along inside a kept one. */
+static char *http_cross_origin_headers(const char *headers)
+{
+    static const char *const kept[] = { "Accept", "Accept-Language",
+                                        "User-Agent", NULL };
+    AVBPrint lines;
+    char *result;
+
+    av_bprint_init(&lines, 0, AV_BPRINT_SIZE_UNLIMITED);
+    while (headers && *headers) {
+        size_t length = strcspn(headers, "\r\n");
+        const char *colon = memchr(headers, ':', length);
+        int i;
+
+        for (i = 0; colon && kept[i]; i++) {
+            if ((size_t)(colon - headers) == strlen(kept[i]) &&
+                !av_strncasecmp(headers, kept[i], colon - headers)) {
+                av_bprint_append_data(&lines, headers, (unsigned)length);
+                av_bprintf(&lines, "\r\n");
+                break;
+            }
+        }
+        headers += length;
+        headers += strspn(headers, "\r\n");
+    }
+    if (!av_bprint_is_complete(&lines) ||
+        av_bprint_finalize(&lines, &result) < 0) {
+        av_bprint_finalize(&lines, NULL);
+        return NULL;
+    }
+    return result;
+}
+
+/* A cookie a response set, as the jar keeps it: tagged with the origin of
+ * the request the response answered, and marked if that request went without
+ * the credentials, in place of any tag or mark the server sent. A cookie
+ * named like either is not kept. */
+static char *http_tagged_cookie(HTTPContext *s, const char *set_cookie)
+{
+    char origin[1024];
+    AVBPrint cookie;
+    const char *param = set_cookie;
+    char *result;
+    int first = 1;
+
+    if (http_url_origin(s->location, origin, sizeof(origin)) < 0)
+        return NULL;
+    av_bprint_init(&cookie, 0, AV_BPRINT_SIZE_UNLIMITED);
+    while (*param) {
+        size_t length = strcspn(param, ";");
+        const char *start = param + strspn(param, WHITESPACES);
+        const char *end = param + length;
+        size_t name_length;
+
+        while (end > start && strchr(WHITESPACES, end[-1]))
+            end--;
+        name_length = strcspn(start, "=;");
+        if (name_length > (size_t)(end - start))
+            name_length = end - start;
+        while (name_length && strchr(WHITESPACES, start[name_length - 1]))
+            name_length--;
+        if (http_is_jar_attribute(start, name_length)) {
+            if (first) {
+                av_bprint_finalize(&cookie, NULL);
+                return NULL;
+            }
+        } else if (end > start) {
+            av_bprintf(&cookie, "%s%.*s", first ? "" : "; ",
+                       (int)(end - start), start);
+        }
+        first = 0;
+        param += length;
+        if (*param == ';')
+            param++;
+    }
+    av_bprintf(&cookie, "; %s=%s", COOKIE_ORIGIN, origin);
+    if (s->request_withheld)
+        av_bprintf(&cookie, "; %s=1", COOKIE_WITHHELD);
+    if (!av_bprint_is_complete(&cookie) ||
+        av_bprint_finalize(&cookie, &result) < 0) {
+        av_bprint_finalize(&cookie, NULL);
+        return NULL;
+    }
+    return result;
 }
 
